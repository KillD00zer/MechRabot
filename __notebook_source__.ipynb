from pathlib import Path
from docling.document_converter import DocumentConverter, PdfFormatOption
from docling.datamodel.base_models import InputFormat
from docling.datamodel.pipeline_options import PdfPipelineOptions ,TableStructureOptions, TableFormerMode
from docling_core.transforms.chunker import HybridChunker
from docling_core.types.doc.labels import DocItemLabel
from docling_core.types.doc.document import ContentLayer
from docling_core.types.doc.base import ImageRefMode



pipeline_options = PdfPipelineOptions(
    do_ocr=True,
    do_table_structure=True,
    generate_picture_images=True,
    image_scale=5,
    table_structure_options=TableStructureOptions(
        mode=TableFormerMode.ACCURATE,   
        do_cell_matching=False           
))

converter = DocumentConverter(
    allowed_formats=[InputFormat.PDF], 
    format_options={
        InputFormat.PDF: PdfFormatOption(pipeline_options=pipeline_options)
        })

pdf_path = "/kaggle/input/datasets/ahmedezzattaha/m11-sm/m11_SM.pdf"
#page_range=(100,130)
artifacts_output_dir = Path("extracted_artifacts")
artifacts_output_dir.mkdir(exist_ok=True)




print("//"*10 + "parsing operation started"+ "\\"*10)
result = converter.convert(pdf_path)
doc = result.document
print("//"*10 + "parsing operation ended"+ "\\"*10)




print("//"*10 + "exporting operation started"+ "\\"*10)
clean_markdown = doc.save_as_markdown(
    filename="output_31.md",
    artifacts_dir=artifacts_output_dir, # Images saved here
    image_mode=ImageRefMode.REFERENCED,
    included_content_layers={ContentLayer.BODY}
)
doc.save_as_html("output_html.html")






import re

chunker = HybridChunker()
chunks = list(chunker.chunk(doc))
print("//"*10 + "exporting & chunking operation ended"+ "\\"*20)

print("ALL DONE")

ready_chunks = []

for chunk in chunks:
    text = chunk.text.strip()

    # Skip junk chunks
    if not text or '. . .' in text:
        continue

    # Pull out image paths → move to metadata
    images = re.findall(r'!\[.*?\]\((extracted_artifacts/[^\)]+)\)', text)
    text = re.sub(r'!\[.*?\]\([^\)]+\)', '', text)

    # Remove artifact noise codes (e.g. BESM020067, VISM010001)
    text = re.sub(r'\b[A-Z]{2,6}\d{5,}\b', '', text)

    # Remove orphan section numbers (lone "02", "01" on their own)
    text = re.sub(r'(?m)^\s*\d{2}\s*$', '', text)

    # Decode HTML entities
    text = text.replace("&amp;", "&").replace("&lt;", "<")

    # Clean up extra whitespace
    text = re.sub(r'\n{3,}', '\n\n', text).strip()

    # Build the breadcrumb for context
    headings = chunk.meta.headings or []
    breadcrumb = " → ".join(headings)
    
    # Prepend breadcrumb so each chunk is self-contained
    final_text = f"[{breadcrumb}]\n{text}" if breadcrumb else text

    ready_chunks.append({
        "text": final_text,
        "images": images,
        "headings": headings,
        "page": chunk.meta.doc_items[0].prov[0].page_no ,
    })

print(f"Clean chunks ready: {len(ready_chunks)}")

# Preview one
print("\n--- CLEANED CHUNK ---")
print(ready_chunks[10]["text"])
print("Images:", ready_chunks[10]["images"])



import json

# اسم الملف اللي هينزل فيه الداتا
output_file = "cleaned_chunks.json"

with open(output_file, 'w', encoding='utf-8') as f:
    json.dump(ready_chunks, f, ensure_ascii=False, indent=4)

print(f"✅ Protocol-Nemesis Data Secured: {output_file}")












